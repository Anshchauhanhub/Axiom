# ─── Database (Neon PostgreSQL) ──────────────────────────
# Format: postgresql+asyncpg://user:password@host/dbname
DATABASE_URL=your-neon-database-url-here

# ─── Telegram Bot ───────────────────────────────────────
TELEGRAM_BOT_TOKEN=your-telegram-bot-token-here
DISABLE_TELEGRAM=false
TELEGRAM_WEBHOOK_SECRET=your-random-webhook-secret-here

# ─── LLM Engine (Groq — free tier, used for casual chat) ─
GROQ_API_KEY=your-groq-api-key-here

# ─── LLM Engine (Anthropic Haiku 4.5 — grounded nodes) ───
# Optional: Leave blank to use Groq for everything (less accurate for exam syllabi)
# Pay-as-you-go, no subscription — ~$0.005 per roadmap generation
ANTHROPIC_API_KEY=your-anthropic-api-key-here

# ─── Security (JWT) ──────────────────────────────────────
JWT_SECRET=your-super-secret-random-string-here
JWT_ALGORITHM=HS256
JWT_EXPIRATION_MINUTES=1440

# ─── CORS ────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ── App Settings ───────────────────────────────────────
APP_ENV=development
DEBUG=true

# ── Agentic Cache (Pinecone + Semantic) ──────────────
# Optional: Leave blank to use exact-match only (no semantic cache)
PINECONE_API_KEY=your-pinecone-api-key-here
PINECONE_INDEX=edxiom-goals
CACHE_SIMILARITY_THRESHOLD=0.91
