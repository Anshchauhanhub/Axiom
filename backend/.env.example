# ─── Database (Neon PostgreSQL) ──────────────────────────
# Format: postgresql+asyncpg://user:password@host/dbname
DATABASE_URL=your-neon-database-url-here

# ─── Telegram Bot ───────────────────────────────────────
TELEGRAM_BOT_TOKEN=your-telegram-bot-token-here
DISABLE_TELEGRAM=false
TELEGRAM_WEBHOOK_SECRET=your-random-webhook-secret-here

# ─── LLM Engine (Groq — free tier, $0 cost) ──────────────
GROQ_API_KEY=your-groq-api-key-here
# Heavy model for roadmaps, docs, MCQs (best quality structured JSON)
GROQ_MODEL=llama-3.3-70b-versatile
# Light model for entity detection, classification (fast, minimal tokens)
GROQ_MODEL_FAST=llama-3.1-8b-instant

# ─── Security (JWT) ──────────────────────────────────────
JWT_SECRET=your-super-secret-random-string-here
JWT_ALGORITHM=HS256
JWT_EXPIRATION_MINUTES=1440

# ─── CORS ────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ── App Settings ───────────────────────────────────────
APP_ENV=development
DEBUG=true

# ── Agentic Cache (Pinecone + Semantic) ──────────────
# Optional: Leave blank to use exact-match only (no semantic cache)
PINECONE_API_KEY=your-pinecone-api-key-here
PINECONE_INDEX=edxiom-goals
CACHE_SIMILARITY_THRESHOLD=0.91

# ── YouTube Resilient Search ──────────────────────────
# Layer 1: YouTube Data API v3 (10k free units/day — 100 searches/day free)
# Get key: https://console.cloud.google.com → YouTube Data API v3
YOUTUBE_API_KEY=your-youtube-data-api-v3-key-here
# Cache TTL for video search results (seconds). 86400 = 24h, used as base.
# Positive hits cached for 7×TTL (7 days), negative hits cached for 1×TTL (24h).
CACHE_TTL=86400
